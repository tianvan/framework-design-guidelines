is_global = true
global_level = -1
# <auto-generated> by fdg-gen from rules/*.yaml — do not edit

# Profile options
dotnet_code_quality.api_surface = all

# FDGA001
csharp_new_line_before_open_brace = all

# FDGA003
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false

# FDGA004
csharp_prefer_braces = true

# FDGA006
csharp_prefer_simple_using_statement = false

# FDGA009
csharp_space_after_comma = true
csharp_space_before_comma = false

# FDGA011
csharp_space_between_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false

# FDGA012
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false

# FDGA013
csharp_space_within_square_brackets = false
csharp_space_before_open_square_brackets = false

# FDGA014
csharp_space_after_keywords_in_control_flow_statements = true

# FDGA015
csharp_space_around_binary_operators = before_and_after

# FDGA017
indent_size = 4
indent_style = space

# FDGA019
csharp_indent_block_contents = true

# FDGA020
csharp_indent_switch_labels = true
csharp_indent_case_contents = true

# FDGA021
csharp_indent_labels = one_less_than_current

# FDGA025
dotnet_style_allow_statement_immediately_after_block_experimental = false:warning

# FDGA027
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# FDGA028
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,volatile,new,virtual,abstract,sealed,override,readonly,unsafe,required,async:warning

# FDGA040
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# FDGA041
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true

# FDGA042
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning

# FDGA043
dotnet_style_object_initializer = true:warning

# FDGA044
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_collection_expression = never:warning

# FDGA046
dotnet_style_prefer_auto_properties = true:warning

# FDGA049
dotnet_style_readonly_field = true:warning

# FDGA050
csharp_style_throw_expression = false

# FDGA052
dotnet_naming_rule.fdga052_types_and_members.symbols = fdg_types_and_members
dotnet_naming_rule.fdga052_types_and_members.style = fdg_pascal_case
dotnet_naming_symbols.fdg_types_and_members.applicable_kinds = namespace, class, struct, interface, enum, delegate, property, method, event, type_parameter
dotnet_naming_symbols.fdg_types_and_members.applicable_accessibilities = *
dotnet_naming_rule.fdga052_visible_fields.symbols = fdg_visible_fields
dotnet_naming_rule.fdga052_visible_fields.style = fdg_pascal_case
dotnet_naming_symbols.fdg_visible_fields.applicable_kinds = field
dotnet_naming_symbols.fdg_visible_fields.applicable_accessibilities = public, protected, protected_internal
dotnet_naming_style.fdg_pascal_case.capitalization = pascal_case
dotnet_naming_rule.fdga052_types_and_members.severity = suggestion
dotnet_naming_rule.fdga052_visible_fields.severity = suggestion

# FDGA053
dotnet_naming_rule.fdga053_const_fields.symbols = fdg_const_fields
dotnet_naming_rule.fdga053_const_fields.style = fdg_pascal_case
