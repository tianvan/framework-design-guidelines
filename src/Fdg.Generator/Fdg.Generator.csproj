<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fdg-gen</AssemblyName>
    <RootNamespace>Fdg.Generator</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="JsonSchema.Net" />
    <!-- The SDK's code style fixers reference it; the generator inspects their types. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <!-- Newer than the analyzer pin so the generator can load the installed SDK's analyzer assemblies. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="5.9.0" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fdg.Generator.Tests" />
  </ItemGroup>

</Project>
